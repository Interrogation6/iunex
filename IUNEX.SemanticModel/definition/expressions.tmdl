expression stg_vendas =
		let
		    Source = Table.Combine({
		        stg_vendas_2026,
		        stg_vendas_2025,
		        stg_vendas_2024
		    }),
		    MergeCambio = Table.NestedJoin(
		        Source,
		        {"data_emissao"},
		        auxCambioDiario,
		        {"data_emissao"},
		        "Cambio",
		        JoinKind.LeftOuter
		    ),
		
		    ExpandCambio = Table.ExpandTableColumn(
		        MergeCambio,
		        "Cambio",
		        {"taxa_ptax_venda"},
		        {"taxa_ptax_venda"}
		    ),
		
		    AddedValorBRL = Table.AddColumn(
		    ExpandCambio,
		    "valor_unitario_brl",
		    each
		        let
		            Valor = try [valor_unitario]
		        in
		            if Valor[HasError] then
		                null
		            else
		                let
		                    Moeda = Text.Upper(Text.Trim([moeda] ?? ""))
		                in
		                    if Moeda = "BRL" then
		                        Currency.From(Valor[Value])
		
		                    else if Moeda = "USD" then
		                        if [taxa_ptax_venda] = null then
		                            error [
		                                Reason = "Cotação não encontrada",
		                                Message = "Não existe cotação USD anterior ou igual à data da venda.",
		                                Detail = [data_emissao]
		                            ]
		                        else
		                            Currency.From(
		                                Valor[Value] * [taxa_ptax_venda]
		                            )
		
		                    else
		                        error [
		                            Reason = "Moeda inválida",
		                            Message = "Moeda não suportada.",
		                            Detail = [moeda]
		                        ],
		    Currency.Type
		),
		
		    RemoveTaxa = Table.RemoveColumns(
		        AddedValorBRL,
		        {"taxa_ptax_venda"}
		    )
		in
		    RemoveTaxa
