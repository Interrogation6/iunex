expression stg_Clientes =
		let
		    Source = clientes,
		    AdjustIDs = Table.TransformColumns(Source, {
		        {"id_cliente", each fxExtrairID(_), Int64.Type},
		        {"id_matriz", each fxExtrairID(_), Int64.Type}
		    }),
		    DuplicateRazao = Table.DuplicateColumn(AdjustIDs, "razao_social", "grupo"),
		    ExtractGrupo = Table.SplitColumn(DuplicateRazao, "grupo", Splitter.SplitTextByEachDelimiter({" "}, QuoteStyle.Csv, false), {"grupo"}),
		    CleanTexts = Table.TransformColumns(ExtractGrupo,{
		        {"segmento", each Text.Trim(Text.Proper(_)), type text},
		        {"grupo", Text.Proper, type text},
		        {"situacao", Text.Proper, type text},
		        {"cidade", Text.Trim, type text}
		    }),
		    JoinSegmento = Table.NestedJoin(CleanTexts, {"segmento"}, auxSegmento, {"Name"}, "auxSegmento", JoinKind.LeftOuter),
		    ExpandSegmento = Table.ExpandTableColumn(JoinSegmento, "auxSegmento", {"Alias"}, {"Alias"}),
		    ApplyAliasSegmento = Table.TransformColumnTypes(
		        Table.ReplaceValue(ExpandSegmento, each [segmento], each if [Alias] <> null then [Alias] else [segmento], Replacer.ReplaceValue, {"segmento"}),
		        {{"segmento", type text}}
		    ),
		    RemoveOldColumns = Table.RemoveColumns(ApplyAliasSegmento, {"Alias", "regiao"}),
		    JoinRegiao = Table.NestedJoin(RemoveOldColumns, {"uf"}, auxRegiao, {"UF"}, "auxRegiao", JoinKind.LeftOuter),
		    ExpandRegiao = Table.ExpandTableColumn(JoinRegiao, "auxRegiao", {"Regiao"}, {"regiao"}),
		    AdjustDatas = Table.TransformColumns(ExpandRegiao, {
		        {"data_cadastro", each try Date.From(_) otherwise try Date.AddDays(#date(1899, 12, 30), Number.From(_)) otherwise null, type date}
		    }),
		    ValidateSituacao = Table.TransformColumns(AdjustDatas, {
		        {"situacao", each if _ = "Ativo" or _ = "Inativo" then _ else error [Reason="Erro de Validação", Message="Situação inválida. O valor deve ser 'Ativo' ou 'Inativo'.", Detail="Valor atual: " & Text.From(_)], type text}
		    }),
		    ValidateCNPJ = Table.TransformColumns(ValidateSituacao, {
		        {"cnpj", each fxValidarCNPJ(_), type text}
		    }),
		    ReorderColumns = Table.ReorderColumns(ValidateCNPJ, {"id_cliente", "id_matriz", "razao_social", "cnpj", "segmento", "regiao", "uf", "cidade", "data_cadastro", "situacao", "grupo"})
		in
		    ReorderColumns
