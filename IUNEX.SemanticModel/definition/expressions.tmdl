expression stg_vendas =
		let
		    Source = Table.Combine({stg_vendas_2026, stg_vendas_2025, stg_vendas_2024}),
		    AddedValorBRL = Table.AddColumn(
		    Source,
		    "valor_unitario_brl",
		    each fxAplicarCambio(
		        [valor_unitario],
		        [data_emissao],
		        [moeda]
		    ),
		    Currency.Type
		)
		in
		    AddedValorBRL
	lineageTag: ddf20dd2-287c-4d0a-b897-90f0d850848e
