expression auxCambioDiario =
		let
		    SelectCotacoesUSD = Table.SelectColumns(
		        Table.SelectRows(
		            cambio_usd,
		            each [moeda] = "USD" and [data_cotacao] <> null
		        ),
		        {"data_cotacao", "taxa_ptax_venda"}
		    ),
		
		    CombineDatasVendas = Table.Combine({
		        Table.SelectColumns(stg_vendas_2024, {"data_emissao"}),
		        Table.SelectColumns(stg_vendas_2025, {"data_emissao"}),
		        Table.SelectColumns(stg_vendas_2026, {"data_emissao"})
		    }),
		
		    FilterDatasValidas = Table.RemoveRowsWithErrors(
		        CombineDatasVendas,
		        {"data_emissao"}
		    ),
		
		    GetDataInicio = List.Min(
		        SelectCotacoesUSD[data_cotacao]
		    ),
		
		    GetDataFim = List.Max(
		        List.Combine({
		            {GetDataInicio},
		            List.RemoveNulls(FilterDatasValidas[data_emissao])
		        })
		    ),
		
		    GenerateCalendario = Table.FromList(
		        List.Dates(
		            GetDataInicio,
		            Duration.Days(GetDataFim - GetDataInicio) + 1,
		            #duration(1, 0, 0, 0)
		        ),
		        Splitter.SplitByNothing(),
		        {"data_emissao"}
		    ),
		
		    ChangeCalendarType = Table.TransformColumnTypes(
		        GenerateCalendario,
		        {{"data_emissao", type date}}
		    ),
		
		    MergeCotacoes = Table.NestedJoin(
		        ChangeCalendarType,
		        {"data_emissao"},
		        SelectCotacoesUSD,
		        {"data_cotacao"},
		        "Cotacao",
		        JoinKind.LeftOuter
		    ),
		
		    ExpandCotacoes = Table.ExpandTableColumn(
		        MergeCotacoes,
		        "Cotacao",
		        {"taxa_ptax_venda"},
		        {"taxa_ptax_venda"}
		    ),
		
		    SortDatas = Table.Sort(
		        ExpandCotacoes,
		        {{"data_emissao", Order.Ascending}}
		    ),
		
		    FillCotacoes = Table.FillDown(
		        SortDatas,
		        {"taxa_ptax_venda"}
		    )
		in
		    FillCotacoes
	lineageTag: 4b970936-4b5c-4125-8d84-cfae574c8d7a
	queryGroup: 'Tabelas Auxiliares'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fxQuarentena =
		let
		    fxQuarentena = (
		        Tabela as table,
		        Origem as text,
		        optional ColunasChave as nullable list
		    ) as table =>
		    let
		        GetChaves = ColunasChave ?? {},
		
		        HasOrigem = Table.HasColumns(
		            Tabela,
		            "origem"
		        ),
		
		        AddIndice = Table.AddIndexColumn(
		            Tabela,
		            "__Linha",
		            1,
		            1,
		            Int64.Type
		        ),
		
		        FilterErros = Table.SelectRowsWithErrors(
		            AddIndice
		        ),
		
		        GetColunas = List.RemoveItems(
		            Table.ColumnNames(FilterErros),
		            {"__Linha"}
		        ),
		
		        AddIdentificador = Table.AddColumn(
		            FilterErros,
		            "__Identificador",
		            (Linha as record) =>
		                if List.IsEmpty(GetChaves) then
		                    Text.From(Linha[__Linha])
		                else
		                    Text.Combine(
		                        List.Transform(
		                            GetChaves,
		                            (Chave) =>
		                                let
		                                    Valor = try Record.Field(
		                                        Linha,
		                                        Chave
		                                    )
		                                in
		                                    if Valor[HasError] then
		                                        "[ERRO]"
		                                    else if Valor[Value] = null then
		                                        "(nulo)"
		                                    else
		                                        Text.From(
		                                            Valor[Value],
		                                            "pt-BR"
		                                        )
		                        ),
		                        " / "
		                    ),
		            type text
		        ),
		
		        AddOrigem = Table.AddColumn(
		            AddIdentificador,
		            "__OrigemQuarentena",
		            (Linha as record) =>
		                if HasOrigem then
		                    let
		                        Tentativa = try Record.Field(
		                            Linha,
		                            "origem"
		                        ),
		
		                        ValorOrigem =
		                            if Tentativa[HasError] then
		                                null
		                            else if Tentativa[Value] = null then
		                                null
		                            else
		                                Text.Trim(
		                                    Text.From(Tentativa[Value])
		                                )
		                    in
		                        if ValorOrigem = null
		                            or ValorOrigem = ""
		                        then
		                            Origem
		                        else
		                            ValorOrigem
		                else
		                    Origem,
		            type text
		        ),
		
		        AddOcorrencias = Table.AddColumn(
		            AddOrigem,
		            "__Ocorrencias",
		            (Linha as record) =>
		                List.RemoveNulls(
		                    List.Transform(
		                        GetColunas,
		                        (Coluna) =>
		                            let
		                                Tentativa = try Record.Field(
		                                    Linha,
		                                    Coluna
		                                )
		                            in
		                                if Tentativa[HasError] then
		                                    [
		                                        Coluna = Coluna,
		                                        Motivo = Tentativa[Error][Message]
		                                    ]
		                                else
		                                    null
		                    )
		                ),
		            type list
		        ),
		
		        SelectColunas = Table.SelectColumns(
		            AddOcorrencias,
		            {
		                "__Linha",
		                "__Identificador",
		                "__OrigemQuarentena",
		                "__Ocorrencias"
		            }
		        ),
		
		        ExpandLista = Table.ExpandListColumn(
		            SelectColunas,
		            "__Ocorrencias"
		        ),
		
		        ExpandMotivos = Table.ExpandRecordColumn(
		            ExpandLista,
		            "__Ocorrencias",
		            {"Coluna", "Motivo"}
		        ),
		
		        RenameColunas = Table.RenameColumns(
		            ExpandMotivos,
		            {
		                {"__Linha", "Linha"},
		                {"__Identificador", "Identificador"},
		                {"__OrigemQuarentena", "Origem"}
		            }
		        ),
		
		        SelectResultado = Table.SelectColumns(
		            RenameColunas,
		            {
		                "Origem",
		                "Linha",
		                "Identificador",
		                "Coluna",
		                "Motivo"
		            }
		        )
		    in
		        SelectResultado
		in
		    fxQuarentena
	lineageTag: 24d22878-9811-4d12-aa1a-8193bdff5604
	queryGroup: 'Parametros & Funcoes'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fxValidarChaveUnica =
		let
		    fxValidarChaveUnica = (
		        Tabela as table,
		        ColunasChave as list
		    ) as table =>
		    let
		        ColunasOriginais = Table.ColumnNames(Tabela),
		
		        ColunaErro = ColunasChave{0},
		
		        TipoChave = Record.Field(
		            Type.RecordFields(
		                Type.TableRow(Value.Type(Tabela))
		            ),
		            ColunaErro
		        )[Type],
		
		        AddIndice = Table.AddIndexColumn(
		            Tabela,
		            "__IndiceUnico",
		            0,
		            1,
		            Int64.Type
		        ),
		
		        SelectChaves = Table.SelectColumns(
		            AddIndice,
		            ColunasChave & {"__IndiceUnico"}
		        ),
		
		        RemoveErrosExistentes = Table.RemoveRowsWithErrors(
		            SelectChaves,
		            ColunasChave
		        ),
		
		        FilterChavesValidas = Table.SelectRows(
		            RemoveErrosExistentes,
		            (Linha) =>
		                List.AllTrue(
		                    List.Transform(
		                        ColunasChave,
		                        (Chave) =>
		                            Record.Field(Linha, Chave) <> null
		                    )
		                )
		        ),
		
		        GroupChaves = Table.Group(
