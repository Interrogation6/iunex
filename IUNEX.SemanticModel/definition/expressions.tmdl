expression fxRejeitarNulo = ```
		let
		    RejeitarNulo = (valor as any, optional nomeColuna as text) =>
		        let
		            EhInvalido = (valor = null) or (try Text.Trim(valor) = "" otherwise false)
		        in
		            if EhInvalido then 
		                error [
		                    Reason="Erro de Valor Nulo ou Vazio", 
		                    Message="Esta informação é obrigatória e não pode estar nula/vazia.", 
		                    Detail="Coluna afetada: " & (nomeColuna ?? "Não especificada")
		                ]
		            else 
		                valor
		in
		    RejeitarNulo
		```
