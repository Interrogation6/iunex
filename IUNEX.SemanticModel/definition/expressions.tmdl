expression stg_devolucoes = ```
		let
		    Source = devolucoes,
		
		    AdjustIDs = Table.TransformColumns(
		        Source,
		        {
		            {"id_devolucao", each fxExtrairID(_, 2), Int64.Type},
		            {"id_pedido_origem", each fxExtrairID(_, 2), Int64.Type}
		        }
		    ),
		    ValidateIDs = fxValidarChaveUnica(
		        AdjustIDs,
		        {"id_devolucao"}
		    ),
		
		    
		SelectVendas = Table.SelectColumns(
		    fVendas,
		    {
		        "id_pedido",
		        "item",
		        "id_cliente_origem",
		        "id_produto_origem",
		        "id_vendedor_origem",
		        "id_filial",
		        "desconto_pct",
		        "valor_unitario_brl"
		    }
		),
		
		MergeVendas = Table.NestedJoin(
		    ValidateIDs,
		    {"id_pedido_origem", "item"},
		    SelectVendas,
		    {"id_pedido", "item"},
		    "VendaOriginal",
		    JoinKind.LeftOuter
		),
		
		ExpandVendas = Table.ExpandTableColumn(
		    MergeVendas,
		    "VendaOriginal",
		    {
		        "id_pedido",
		        "id_cliente_origem",
		        "id_produto_origem",
		        "id_vendedor_origem",
		        "id_filial",
		        "desconto_pct",
		        "valor_unitario_brl"
		    }
		),
		
		    ValidatePedido = Table.TransformColumns(
		        ExpandVendas,
		        {
		            {
		                "id_pedido",
		                each
		                    if _ = null then
		                        error [
		                            Reason = "Erro de Relacionamento",
		                            Message = "Não foi possível localizar o item da venda original."
		                        ]
		                    else
		                        _,
		                Int64.Type
		            }
		        }
		    ),
		
		    AddedValorLiquido = Table.AddColumn(
		        ValidatePedido,
		        "valor_liquido",
		        each
		            [valor_unitario_brl]
		            * (1 - [desconto_pct])
		            * [quantidade_devolvida],
		        Currency.Type
		    )
		in
		    AddedValorLiquido
		```
	lineageTag: 1cbcdc57-ac47-4110-acb0-ac6b66f230b1
	queryGroup: Stage

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

