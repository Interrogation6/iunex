	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fxAplicarCambio =
		(
		    valorUnitario as number,
		    dataEmissao as date,
		    moeda as text
		) as number =>
		
		let
		    MoedaNormalizada = Text.Upper(Text.Trim(moeda)),
		
		    ValorConvertido =
		        if MoedaNormalizada = "BRL" then
		            valorUnitario
		
		        else if MoedaNormalizada = "USD" then
		            let
		                CotacoesDisponiveis = Table.SelectRows(
		                    cambio_usd,
		                    each [data_cotacao] <= dataEmissao
		                        and [moeda] = MoedaNormalizada
		                ),
		
		                OrdenarCotacoes = Table.Sort(
		                    CotacoesDisponiveis,
		                    {{"data_cotacao", Order.Descending}}
		                ),
		
		                Taxa =
		                    if Table.IsEmpty(OrdenarCotacoes) then
		                        error "Nenhuma cotação PTAX disponível anterior à data de emissão: "
		                            & Date.ToText(dataEmissao, "dd/MM/yyyy")
		                    else
		                        OrdenarCotacoes{0}[taxa_ptax_venda]
		            in
		                valorUnitario * Taxa
		
		        else
		            error "Moeda não suportada: " & MoedaNormalizada
		
		in
		    ValorConvertido
	lineageTag: b2129ce5-093d-4aa9-8e85-5f23fd0a8e23
	queryGroup: 'Parametros & Funcoes'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

