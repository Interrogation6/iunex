		    Source = vendas_2024,
		
		    RenameColumns = Table.RenameColumns(Source, {
		        {"ID_PEDIDO", "id_pedido"},
		        {"ITEM", "item"},
		        {"DT_EMISSAO", "data_emissao"},
		        {"COD_CLIENTE", "id_cliente"},
		        {"COD_PRODUTO", "id_produto"},
		        {"COD_VENDEDOR", "id_vendedor"},
		        {"QTDE", "quantidade"},
		        {"VLR_UNITARIO", "valor_unitario"},
		        {"DESCONTO", "desconto_pct"},
		        {"MOEDA", "moeda"},
		        {"CANAL", "canal"}
		    }),
		
		    AdjustIDs = Table.TransformColumns(RenameColumns, {
		    {"id_pedido", each fxExtrairID(_, 2), Int64.Type},
		    {"id_cliente", each fxExtrairID(_, 1), Int64.Type},
		    {"id_produto", each fxExtrairID(_, 4), Int64.Type}
		}),
		    ValidateVendedor = Table.AddColumn(
		    AdjustIDs,
		    "id_vendedor_validado",
		    each
		        if [canal] = "E-commerce"
		            and (
		                [id_vendedor] = null
		                or Text.Trim([id_vendedor]) = ""
		            )
		        then null
		        else fxExtrairID([id_vendedor], 1),
		        Int64.Type
		),
		    RemoveVendedorOriginal = Table.RemoveColumns(
		    ValidateVendedor,
		    {"id_vendedor"}
		),
		
		RenameVendedor = Table.RenameColumns(
		    RemoveVendedorOriginal,
		    {{"id_vendedor_validado", "id_vendedor"}}
		),
		    ValidateNulls = Table.TransformColumns(RenameVendedor, {
		    {"quantidade", each fxRejeitarNulo(_), Int64.Type},
		    {"valor_unitario", each fxRejeitarNulo(_), Currency.Type}
		}),
		    AddedStatusPedido = Table.AddColumn(ValidateNulls, "status_pedido", each if [quantidade] >= 0 then "Faturado" else "Cancelado", type text),
		    AdjustQuantidade = Table.TransformColumns(AddedStatusPedido, {{"quantidade", each Number.Abs(_), type number}}),
		    AddedFreteRateado = Table.AddColumn(AdjustQuantidade, "frete_rateado", each null, Currency.Type),
		    #"Changed Type" = Table.TransformColumns(
		    AddedFreteRateado,
		    {
		        {"desconto_pct", each _ / 100, Percentage.Type}
		    }
		),
		    AddedOrigem = Table.AddColumn(#"Changed Type", "origem", each "Vendas_2024")
		in
		    AddedOrigem
