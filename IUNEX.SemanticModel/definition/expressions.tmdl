expression fxValidarCNPJ = ```
		let
		    ValidaCNPJ = (cnpj as any) =>
		    let
		        // 1. Extrai apenas os números (retorna null se o valor original for null)
		        cnpjLimpo = if cnpj = null then null else Text.Select(Text.From(cnpj), {"0".."9"}),
		        
		        // 2. Validações e Retornos
		        Resultado = 
		            if cnpjLimpo = null then 
		                null 
		            else if Text.Length(cnpjLimpo) <> 14 then 
		                error [Reason="Erro de Validação", Message="Tamanho inválido. O CNPJ deve conter exatamente 14 números.", Detail=cnpj]
		            else
		                let
		                    // Converte a string em uma lista de números
		                    ListaNumeros = List.Transform(Text.ToList(cnpjLimpo), each Number.From(_)),
		                    
		                    // Lista de CNPJs inválidos conhecidos
		                    InvalidosConhecidos = {"00000000000000","11111111111111","22222222222222","33333333333333","44444444444444","55555555555555","66666666666666","77777777777777","88888888888888","99999999999999"},
		                    
		                    // Cálculo do 1º Dígito
		                    Pesos1 = {5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2},
		                    Soma1 = List.Sum(List.Transform({0..11}, each ListaNumeros{_} * Pesos1{_})),
		                    Resto1 = Number.Mod(Soma1, 11),
		                    Digito1 = if Resto1 < 2 then 0 else 11 - Resto1,
		                    
		                    // Cálculo do 2º Dígito
		                    Pesos2 = {6, 5, 4, 3, 2, 9, 8, 7, 6, 5, 4, 3, 2},
		                    Soma2 = List.Sum(List.Transform({0..12}, each ListaNumeros{_} * Pesos2{_})),
		                    Resto2 = Number.Mod(Soma2, 11),
		                    Digito2 = if Resto2 < 2 then 0 else 11 - Resto2,
		                    
		                    // Validação final
		                    EhValido = (Digito1 = ListaNumeros{12}) and (Digito2 = ListaNumeros{13}) and not List.Contains(InvalidosConhecidos, cnpjLimpo),
		                    
		                    // Aplicação da máscara de pontuação
		                    CnpjFormatado = Text.Range(cnpjLimpo, 0, 2) & "." & 
		                                    Text.Range(cnpjLimpo, 2, 3) & "." & 
		                                    Text.Range(cnpjLimpo, 5, 3) & "/" & 
		                                    Text.Range(cnpjLimpo, 8, 4) & "-" & 
		                                    Text.Range(cnpjLimpo, 12, 2)
		                in
		                    if EhValido then CnpjFormatado else error [Reason="Erro de Validação", Message="CNPJ inválido de acordo com o cálculo da Receita Federal.", Detail=cnpj]
		    in
		        Resultado
		in
		    ValidaCNPJ
		```
	lineageTag: a95d7531-3579-402d-80e4-79824c4bd851
	queryGroup: 'Parametros & Funcoes'

