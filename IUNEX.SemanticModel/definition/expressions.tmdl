expression stg_Carteira_Historica =
		let
		    Source = carteira_historica,
		    AdjustIDs = Table.TransformColumns(Source, {
		        {"id_cliente", each fxExtrairID(_), Int64.Type},
		        {"id_vendedor", each fxExtrairID(_), Int64.Type}
		    }),
		    ValidateVigencia = Table.AddColumn(
		        AdjustIDs,
		        "vigencia_fim_validada",
		        each
		            if [vigencia_inicio] <> null
		                and [vigencia_fim] <> null
		                and [vigencia_inicio] > [vigencia_fim]
		            then
		                error [
		                    Reason = "Vigência Inválida",
		                    Message = "A data de início é posterior à data de fim.",
		                    Detail =
		                        "Início: " & Text.From([vigencia_inicio])
		                        & " | Fim: " & Text.From([vigencia_fim])
		                ]
		            else [vigencia_fim],
		        type nullable date
		    ),
		
		    RemoveColunaOriginal = Table.RemoveColumns(
		        ValidateVigencia,
		        {"vigencia_fim"}
		    ),
		
		    RenameColuna = Table.RenameColumns(
		        RemoveColunaOriginal,
		        {{"vigencia_fim_validada", "vigencia_fim"}}
		    )
		
		in
		    RenameColuna
	lineageTag: 35812855-11c2-4be9-86af-cdb9ebe31ec8
	queryGroup: Stage

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fxExtrairID = ```
		let
		    ExtrairID = (valor as any, optional qtdRemover as number) =>
		        let
		            // Se qtdRemover não for informado (null), assume o valor padrão de 1
		            Qtd = qtdRemover ?? 1,
		            
		            // Converte para texto de forma segura, tratando null
		            TextoValor = if valor = null then "" else Text.From(valor),
		            
		            // Tenta pular a quantidade de caracteres definida e converter para inteiro
		            Tentativa = try Int64.From(Text.Middle(TextoValor, Qtd))
		        in
		            if Tentativa[HasError] or Tentativa[Value] = null then 
		                error [
		                    Reason="Erro de Conversão de ID", 
		                    Message="Não foi possível converter o ID. O valor esperado não pôde ser transformado em número após remover " & Text.From(Qtd) & " caractere(s).", 
		                    Detail="Valor Atual: " & (if valor = null then "null" else Text.From(valor))
		                ]
		            else 
		                Tentativa[Value]
		in
		    ExtrairID
		```
	lineageTag: 03cd1241-bdac-485f-932b-7304dff6adc7
	queryGroup: 'Parametros & Funcoes'

	annotation PBI_NavigationStepName = Navigation

