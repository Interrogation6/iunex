model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Tabelas de Origem sem transformação.
queryGroup Origem

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Tabelas Auxiliares'

	annotation PBI_QueryGroupOrder = 4

queryGroup Stage

	annotation PBI_QueryGroupOrder = 5

queryGroup 'Parametros & Funcoes'

	annotation PBI_QueryGroupOrder = 3

queryGroup Origem\Vendas

	annotation PBI_QueryGroupOrder = 1

queryGroup Stage\Vendas

	annotation PBI_QueryGroupOrder = 1

queryGroup Modelo

	annotation PBI_QueryGroupOrder = 8

queryGroup Origem\Metas

	annotation PBI_QueryGroupOrder = 0

queryGroup Stage\Metas

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["cambio_usd","carteira_historica","clientes","devolucoes","feriados","produtos","seguranca_acessos","stg_metas","stg_Carteira_Historica","stg_Clientes","auxSegmento","Path","auxRegiao","fxValidarCNPJ","fxExtrairID","stg_devolucoes","stg_produtos","fxRejeitarNulo","stg_seguranca_acessos","stg_vendas","stg_vendedores","vendas_2024","vendas_2025","vendas_2026","vendedores","stg_vendas_2024","stg_vendas_2025","stg_vendas_2026","fVendas","fDevolucoes","metas_2024","metas_2025","metas_2026","stg_metas_2024","stg_metas_2025","stg_metas_2026","fMetas","dCalendario","dCartHist","dClientes","dProdutos","dAcessos","dVendedores","metas_workbook","auxCambioDiario","fxQuarentena","fErros"]

annotation PBI_ProTooling = ["DevMode"]

ref table fVendas
ref table fDevolucoes
ref table fMetas
ref table dCartHist
ref table dClientes
ref table dProdutos
ref table dAcessos
ref table dVendedores
ref table fErros
ref table dCalendario

ref cultureInfo en-US

