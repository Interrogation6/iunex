	measure 'Data Máxima da Base' =
			
			CALCULATE(
			    MAX(fVendas[data_emissao]),
			    REMOVEFILTERS()
			)
		formatString: General Date
		displayFolder: Datas
		lineageTag: 3fb83b59-9eab-4195-95c7-b6fd874bf35a

	measure 'Status do Mês Corrente' =
			
			VAR DataBase = [Data Máxima da Base]
			
			VAR InicioMes =
			    DATE(YEAR(DataBase), MONTH(DataBase), 1)
			
			VAR MinContexto = MIN(dCalendario[data])
			VAR MaxContexto = MAX(dCalendario[data])
			
			RETURN
			    IF(
			        NOT ISBLANK(DataBase)
			            && DataBase < EOMONTH(DataBase, 0)
			            && MinContexto <= DataBase
			            && MaxContexto >= InicioMes,
			        "Dados disponíveis até "
			            & FORMAT(DataBase, "dd/MM/yyyy")
			            & " — mês incompleto",
			        BLANK()
			    )
		displayFolder: Datas
		lineageTag: 95d50148-c49a-4bb4-8c39-a9ab103d748a

	measure 'Orçamento Anual Aprovado' =
			
			CALCULATE(
			    SUM(fMetas[valor_meta]),
			    fMetas[mes] = "Meta Ano",
			    fMetas[regiao] <> "Total Geral"
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Metas
		lineageTag: 5c108d88-90f1-461f-afc3-2d886ebf5674

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Meta Geral' =
			
			CALCULATE(
			    SUM(fMetas[valor_meta]),
			    fMetas[regiao] = "Total Geral"
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Metas
		lineageTag: 0e6e3305-16f7-48ea-9646-465904554c5b

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Receita Acumulada ABC %' =
			
			VAR ReceitaAtual =
			    [Receita Líquida]
			
			VAR Clientes =
			    ADDCOLUMNS(
			        FILTER(
			            ALLSELECTED(dClientes),
			            dClientes[id_cliente] <> -1
			        ),
			        "@Receita", [Receita Líquida]
			    )
			
			VAR ReceitaTotal =
			    SUMX(Clientes, [@Receita])
			
			VAR ReceitaAcumulada =
			    SUMX(
			        FILTER(
			            Clientes,
			            [@Receita] >= ReceitaAtual
			        ),
			        [@Receita]
			    )
			
			RETURN
			    IF(
			        HASONEVALUE(dClientes[id_cliente]),
			        DIVIDE(ReceitaAcumulada, ReceitaTotal)
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Receita
		lineageTag: a97bdf68-d971-436a-923b-d3bdb2080a48

	measure 'Receita Líquida ACM % - Cliente' =
			
			VAR ReceitaAtual = [Receita Líquida]
			
			VAR ReceitaAcumulada =
			    SUMX(
			        FILTER(
			            ALLSELECTED(dClientes[razao_social]),
			            [Receita Líquida] >= ReceitaAtual
			        ),
			        [Receita Líquida]
			    )
			
			VAR ReceitaTotal =
			    CALCULATE(
			        [Receita Líquida],
			        ALLSELECTED(dClientes[razao_social])
			    )
			
			RETURN
			    DIVIDE(ReceitaAcumulada, ReceitaTotal)
		displayFolder: Clientes
		lineageTag: 047ed078-93bf-4432-b058-97b1d6da208f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

