	measure 'Data Máxima da Base' =
			
			CALCULATE(
			    MAX(fVendas[data_emissao]),
			    REMOVEFILTERS()
			)
		formatString: General Date
		displayFolder: Datas
		lineageTag: 3fb83b59-9eab-4195-95c7-b6fd874bf35a

	measure 'Status do Mês Corrente' =
			
			VAR DataBase = [Data Máxima da Base]
			
			VAR InicioMes =
			    DATE(YEAR(DataBase), MONTH(DataBase), 1)
			
			VAR MinContexto = MIN(dCalendario[data])
			VAR MaxContexto = MAX(dCalendario[data])
			
			RETURN
			    IF(
			        NOT ISBLANK(DataBase)
			            && DataBase < EOMONTH(DataBase, 0)
			            && MinContexto <= DataBase
			            && MaxContexto >= InicioMes,
			        "Dados disponíveis até "
			            & FORMAT(DataBase, "dd/MM/yyyy")
			            & " — mês incompleto",
			        BLANK()
			    )
		displayFolder: Datas
		lineageTag: 95d50148-c49a-4bb4-8c39-a9ab103d748a

	measure 'Orçamento Anual Aprovado' =
			
			CALCULATE(
			    SUM(fMetas[valor_meta]),
			    fMetas[mes] = "Meta Ano",
			    fMetas[regiao] <> "Total Geral"
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Metas
