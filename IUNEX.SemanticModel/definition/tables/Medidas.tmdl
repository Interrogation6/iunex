	measure 'Clientes Ativos' =
			
			VAR DataReferencia = MAX(dCalendario[data])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(fVendas[id_cliente]),
			    DATESBETWEEN(
			        dCalendario[data],
			        DataReferencia - 89,
			        DataReferencia
			    ),
			    fVendas[id_cliente] <> -1,
			    NOT ISBLANK(fVendas[id_cliente])
			)
		formatString: 0
		displayFolder: Clientes
		lineageTag: ce9f0411-86cd-4669-8691-8f4a09a515ea

	measure 'Clientes Reativados' =
			
			VAR InicioMes =
			    DATE(
			        YEAR(MAX(dCalendario[data])),
			        MONTH(MAX(dCalendario[data])),
			        1
			    )
			
			VAR FimMes = EOMONTH(InicioMes, 0)
			
			RETURN
			COUNTROWS(
			    FILTER(
			        VALUES(dClientes[id_cliente]),
			        VAR ReceitaMes =
			            CALCULATE(
			                [Receita Bruta -Desconto],
			                DATESBETWEEN(
			                    dCalendario[data],
			                    InicioMes,
			                    FimMes
			                )
			            )
			
			        VAR UltimaCompra =
			            CALCULATE(
			                MAX(fVendas[data_emissao]),
			                REMOVEFILTERS(dCalendario),
			                fVendas[data_emissao] < InicioMes
			            )
			
			        RETURN
			            ReceitaMes > 50000
			                && NOT ISBLANK(UltimaCompra)
			                && DATEDIFF(
			                    UltimaCompra,
			                    InicioMes,
			                    DAY
			                ) > 90
			    )
			)
		formatString: 0
		displayFolder: Clientes
		lineageTag: bb2cab5c-281e-46fd-ac15-5a617daaebbc

	measure 'Dias sem Comprar' =
			
			VAR DataReferencia =
			    MAX(dCalendario[data])
			
			VAR UltimaCompra =
			    CALCULATE(
			        MAX(fVendas[data_emissao]),
			        REMOVEFILTERS(dCalendario),
			        fVendas[data_emissao] <= DataReferencia
			    )
			
			RETURN
			    IF(
			        ISBLANK(UltimaCompra),
			        BLANK(),
			        DATEDIFF(
			            UltimaCompra,
			            DataReferencia,
			            DAY
			        )
			    )
		formatString: 0
		displayFolder: Clientes
		lineageTag: 2ed3db30-b2d5-49ad-804a-fb9954abb7fb

	measure 'Receita Bruta -Desconto' =
			
			sum(fVendas[receita_liquida])
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Receita
		lineageTag: 4c64d356-af97-484c-9626-698142765f1c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Faixa de Recência' =
			
			VAR Dias = [Dias sem Comprar]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Dias), BLANK(),
			        Dias <= 30, "0 a 30 dias",
			        Dias <= 60, "31 a 60 dias",
			        Dias <= 90, "61 a 90 dias",
			        "Mais de 90 dias"
			    )
		displayFolder: Clientes
		lineageTag: 100eab62-679e-4214-b52b-726e37ea956e

	measure 'Receita de Clientes Reativados' =
			
			VAR InicioMes =
			    DATE(
			        YEAR(MAX(dCalendario[data])),
			        MONTH(MAX(dCalendario[data])),
			        1
			    )
			
			VAR FimMes =
			    EOMONTH(InicioMes, 0)
			
			RETURN
			    SUMX(
			        VALUES(dClientes[id_cliente]),
			        IF(
			            [Clientes Reativados] = 1,
			            CALCULATE(
			                [Receita Bruta -Desconto],
			                DATESBETWEEN(
			                    dCalendario[data],
			                    InicioMes,
			                    FimMes
			                )
			            )
			        )
			    )
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Clientes
		lineageTag: cb4cdcee-9ed1-4a19-9d99-4fd4d2461156

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Ocorrências de Erro' =
			
