	measure 'Quantidade Classe C' = ```
			
			VAR Tipo =
			    MAXX(
			        SUMMARIZE(
			            pAnaliseABC,
			            pAnaliseABC[pAnaliseABC],
			            pAnaliseABC[pAnaliseABC Fields]
			        ),
			        pAnaliseABC[pAnaliseABC]
			    )
			RETURN 
			    SWITCH(
			        Tipo,
			        "Cliente",
			            COUNTROWS(
			                FILTER(
			                    VALUES(dClientes[razao_social]),
			                    [Classe ABC Dinâmica] = "C"
			                )
			            ),
			        "Produto",
			            COUNTROWS(
			                FILTER(
			                    VALUES(dProdutos[descricao]),
			                    [Classe ABC Dinâmica] = "C"
			                )
			            )
			    )
			```
		formatString: 0
		displayFolder: ABC
		lineageTag: 8c7122a1-54b7-4807-9eaf-c6836955b3b6

	measure 'Receita Líquida ACM % - ABC' =
			
			SWITCH(
			    TRUE(),
			
			    ISINSCOPE(dClientes[razao_social]),
			        [Receita Líquida ACM % - Cliente],
			
			    ISINSCOPE(dProdutos[descricao]),
			        VAR ReceitaAtual = [Receita Líquida]
			
			        VAR Produtos =
			            ADDCOLUMNS(
			                ALLSELECTED(dProdutos[descricao]),
			                "@Receita", CALCULATE([Receita Líquida])
			            )
			
			        VAR ReceitaAcumulada =
			            SUMX(
			                FILTER(
			                    Produtos,
			                    [@Receita] >= ReceitaAtual
			                ),
			                [@Receita]
			            )
			
			        VAR ReceitaTotal =
			            SUMX(
			                Produtos,
			                [@Receita]
			            )
			
			        RETURN
			            DIVIDE(ReceitaAcumulada, ReceitaTotal),
			
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: ABC
		lineageTag: 1fe4318c-f99c-4011-8cb7-cade5e9dfead

	measure 'Aux Título Curva ABC' =
			
			VAR Selecao =
			    SELECTCOLUMNS(
			        SUMMARIZE(
			            pAnaliseABC,
			            pAnaliseABC[pAnaliseABC],
			            pAnaliseABC[pAnaliseABC Fields]
			        ),
			        "Nome", pAnaliseABC[pAnaliseABC]
			    )
			
			RETURN
			    "Curva ABC de " &
			    IF(
			        COUNTROWS(Selecao) = 1,
			        MAXX(Selecao, [Nome]),
			        "Clientes e Produtos"
			    )
		displayFolder: _Aux
		lineageTag: e873bec8-42d1-4177-af3b-217997fe70a6

