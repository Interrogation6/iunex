	measure 'Receita Líquida ACM % - Cliente' =
			
			VAR ReceitaAtual = [Receita Líquida]
			
			VAR ReceitaAcumulada =
			    SUMX(
			        FILTER(
			            ALLSELECTED(dClientes[razao_social]),
			            [Receita Líquida] >= ReceitaAtual
			        ),
			        [Receita Líquida]
			    )
			
			VAR ReceitaTotal =
			    CALCULATE(
			        [Receita Líquida],
			        ALLSELECTED(dClientes[razao_social])
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(ReceitaTotal), BLANK(),
			        ReceitaTotal = 0, "Indefinido",
			        DIVIDE(ReceitaAcumulada, ReceitaTotal)
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Clientes
		lineageTag: 047ed078-93bf-4432-b058-97b1d6da208f

	measure 'Variação YoY %' =
			
			VAR ReceitaAtual =
			    [Receita Líquida YTD FY]
			
			VAR ReceitaAnterior =
			    [Receita Líquida YTD FY Anterior]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(ReceitaAnterior), BLANK(),
			        ReceitaAnterior = 0, "Indefinido",
			        DIVIDE(
			            ReceitaAtual - ReceitaAnterior,
			            ReceitaAnterior
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Receita
		lineageTag: 490b7bbf-23f0-4078-98e2-3b0ff54f99c1

	measure 'Aviso Mês Incompleto' =
			
			VAR DataCorte =
			    CALCULATE(
			        MAX(fVendas[data_emissao]),
			        REMOVEFILTERS()
			    )
			
			VAR UltimoDiaMes =
			    EOMONTH(DataCorte, 0)
			
			VAR InicioMes =
			    DATE(
			        YEAR(DataCorte),
			        MONTH(DataCorte),
			        1
			    )
			
			VAR MesEstaVisivel =
			    COUNTROWS(
			        FILTER(
			            VALUES(dCalendario[data]),
			            dCalendario[data] >= InicioMes
			                && dCalendario[data] <= UltimoDiaMes
			        )
			    ) > 0
			
			RETURN
			    IF(
			        NOT ISBLANK(DataCorte)
			            && DataCorte < UltimoDiaMes
			            && MesEstaVisivel,
			        "Dados até "
			            & FORMAT(DataCorte, "dd/MM/yyyy")
			            & " — mês incompleto. ",
			        " "
			    )
		displayFolder: _Erros
		lineageTag: dba46889-ab9f-40bd-9aa4-f19dcc9e3d54

	measure 'Aux Titulo Metrica Selecionada' =
			
			VAR Metrica =
			    SELECTCOLUMNS(
			        SUMMARIZE(
			            pMetricaExecutiva,
			            pMetricaExecutiva[pMetricaExecutiva],
			            pMetricaExecutiva[pMetricaExecutiva Fields]
			        ),
			        "Nome", pMetricaExecutiva[pMetricaExecutiva]
			    )
			
			RETURN
			    IF(
			        COUNTROWS(Metrica) = 1,
			        MAXX(Metrica, [Nome]),
			        "Métricas"
			    ) & " & Metas"
		displayFolder: _Aux
		lineageTag: 14efa043-2b4c-4e0c-b3ab-be373ff020df

