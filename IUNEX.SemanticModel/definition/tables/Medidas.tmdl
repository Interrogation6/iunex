	measure Meta = ```
			
			VAR DetalheCanal =
			    ISINSCOPE(fVendas[canal])
			
			VAR MetaMensal =
			    CALCULATE(
			        SUM(fMetas[valor_meta]),
			
			        REMOVEFILTERS(fVendas[canal]),
			
			        KEEPFILTERS(
			            fMetas[mes] IN {
			                "Jan", "Fev", "Mar", "Abr",
			                "Mai", "Jun", "Jul", "Ago",
			                "Set", "Out", "Nov", "Dez"
			            }
			        ),
			
			        KEEPFILTERS(
			            fMetas[regiao] <> "Total Geral"
			        )
			    )
			
			RETURN
			    IF(
			        DetalheCanal,
			        BLANK(),
			        MetaMensal
			    )
			
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Metas
		lineageTag: 4ce3cf30-b902-4ec8-8199-b8bfda3c9d68

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

