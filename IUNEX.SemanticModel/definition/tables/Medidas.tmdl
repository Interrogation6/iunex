		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Receita Líquida' =
			
			[Receita Bruta -Desconto] - [Receita Devoluções]
		displayFolder: Receita
		lineageTag: 29f1009e-8ec0-43e1-9e58-6e943f77dce5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pedidos Faturados' =
			
			DISTINCTCOUNT(fVendas[id_pedido])
		formatString: #,0
		displayFolder: Receita
		lineageTag: 7924ac26-2375-42f3-b74b-7ec0f708190f

	measure 'Ticket Médio por Pedido' =
			
			DIVIDE(
			    [Receita Bruta -Desconto],
			    [Pedidos Faturados]
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Receita
		lineageTag: 2212cae7-1621-466c-a4b6-e2577be4db88

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% Devolução sobre Receita Bruta' =
			
			DIVIDE(
			    [Receita Devoluções],
			    [Receita Bruta]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Devoluções
		lineageTag: 6bc3890e-46e9-4bad-bf45-b7d8ee38feb2

	measure Meta =
			
			VAR DetalheCanal =
			    ISINSCOPE(fVendas[canal])
			        || ISFILTERED(fVendas[canal])
			
			VAR MetaMensal =
			    CALCULATE(
			        SUM(fMetas[valor_meta]),
			        KEEPFILTERS(
			            fMetas[mes] IN {
			                "Jan", "Fev", "Mar", "Abr",
			                "Mai", "Jun", "Jul", "Ago",
			                "Set", "Out", "Nov", "Dez"
			            }
			        ),
			        KEEPFILTERS(
			            fMetas[regiao] <> "Total Geral"
			        )
			    )
			
			RETURN
			    IF(
			        DetalheCanal,
			        BLANK(),
			        MetaMensal
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Metas
		lineageTag: 4ce3cf30-b902-4ec8-8199-b8bfda3c9d68

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '% Atingimento da Meta' =
			
			VAR MetaAtual = [Meta]
			RETURN
			    IF(
			        ISBLANK(MetaAtual),
			        BLANK(),
			        DIVIDE(
			            [Receita Líquida],
			            MetaAtual
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Metas
		lineageTag: 4f11dcff-48a4-48ac-ae8d-0121ff41ef84

	measure 'Desvio da Meta R$' =
			
			VAR MetaAtual = [Meta]
			RETURN
			    IF(
			        ISBLANK(MetaAtual),
			        BLANK(),
			        [Receita Líquida] - MetaAtual
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Metas
		lineageTag: 4ba3d773-e252-4431-ac00-b1e7556559e7

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Desvio da Meta %' =
			
			VAR MetaAtual = [Meta]
			RETURN
			    IF(
			        ISBLANK(MetaAtual),
			        BLANK(),
			        DIVIDE(
			            [Receita Líquida] - MetaAtual,
			            MetaAtual
