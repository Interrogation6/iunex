	measure 'Chaves Órfãs de Clientes' =
			
			VAR Vendas =
			    CALCULATETABLE(
			        VALUES(fVendas[id_cliente_origem]),
			        KEEPFILTERS(fVendas[id_cliente] = -1),
			        KEEPFILTERS(
			            NOT ISBLANK(fVendas[id_cliente_origem])
			        )
			    )
			
			VAR Devolucoes =
			    CALCULATETABLE(
			        VALUES(fDevolucoes[id_cliente_origem]),
			        KEEPFILTERS(fDevolucoes[id_cliente] = -1),
			        KEEPFILTERS(
			            NOT ISBLANK(fDevolucoes[id_cliente_origem])
			        )
			    )
			
			RETURN
			    COUNTROWS(
			        DISTINCT(
			            UNION(Vendas, Devolucoes)
			        )
			    )
		formatString: 0
		displayFolder: _Erros\Chaves Orfãs
		lineageTag: 051629a6-0c07-4260-af1b-d8416631d231

