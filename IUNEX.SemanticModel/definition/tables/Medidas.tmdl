	measure 'Dias Inatividade Pré-Reativação' = ```
			
			VAR DataBase =
			    [Data Máxima da Base]
			
			VAR DataContexto =
			    MAX(dCalendario[data])
			
			VAR DataReferencia =
			    MIN(DataBase, DataContexto)
			
			VAR InicioMes =
			    DATE(
			        YEAR(DataReferencia),
			        MONTH(DataReferencia),
			        1
			    )
			
			VAR UltimaCompraAnterior =
			    CALCULATE(
			        MAX(fVendas[data_emissao]),
			        REMOVEFILTERS(dCalendario),
			        fVendas[data_emissao] < InicioMes
			    )
			
			RETURN
			    IF(
			        ISBLANK(DataBase)
			            || ISBLANK(UltimaCompraAnterior),
			        BLANK(),
			        DATEDIFF(
			            UltimaCompraAnterior,
			            InicioMes,
			            DAY
			        )
			    )
			
			```
		formatString: 0
		displayFolder: Datas
		lineageTag: 63ba504c-00e9-4e50-b5db-66f5ff638cea

	measure 'Clientes por Faixa de Recência' =
			
			VAR MinDias =
			    SELECTEDVALUE(dFaixasRecencia[MinDias])
			
			VAR MaxDias =
			    SELECTEDVALUE(dFaixasRecencia[MaxDias])
			
			VAR Quantidade =
			    COUNTROWS(
			        FILTER(
			            VALUES(dClientes[id_cliente]),
			
			            VAR ClienteID =
			                dClientes[id_cliente]
			
			            VAR Dias =
			                [Dias sem Comprar]
			
			            RETURN
			                ClienteID <> -1
			                    && NOT ISBLANK(Dias)
			                    && Dias >= MinDias
			                    && Dias <= MaxDias
			        )
			    )
			
			RETURN
			    IF(
			        ISBLANK(MinDias)
			            || ISBLANK(MaxDias),
			        BLANK(),
			        COALESCE(Quantidade, 0)
			    )
		formatString: 0
		displayFolder: Clientes
		lineageTag: de2c5e10-3c50-41f4-b684-44fac69adc96

	measure 'Classe ABC Dinâmica' =
			
			VAR Percentual = [Receita Líquida ACM % - ABC]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT ISNUMBER(Percentual), BLANK(),
			        Percentual <= 0.80, "A",
			        Percentual <= 0.95, "B",
			        "C"
			    )
		displayFolder: Clientes
		lineageTag: 83a7aedf-b080-41e5-b647-7e24ada94f08

	measure 'Quantidade Classe B' = ```
			
			VAR Tipo =
			    MAXX(
			        SUMMARIZE(
			            pAnaliseABC,
			            pAnaliseABC[pAnaliseABC],
			            pAnaliseABC[pAnaliseABC Fields]
			        ),
			        pAnaliseABC[pAnaliseABC]
			    )
			RETURN 
			    SWITCH(
			        Tipo,
			        "Cliente",
			            COUNTROWS(
			                FILTER(
			                    VALUES(dClientes[razao_social]),
			                    [Classe ABC Dinâmica] = "B"
			                )
			            ),
			        "Produto",
			            COUNTROWS(
			                FILTER(
			                    VALUES(dProdutos[descricao]),
			                    [Classe ABC Dinâmica] = "B"
			                )
			            )
			    )
