	measure 'Chaves Órfãs de Clientes' =
			
			VAR Vendas =
			    SELECTCOLUMNS(
			        FILTER(
			            fVendas,
			            fVendas[id_cliente] = -1
			                && NOT ISBLANK(fVendas[id_cliente_origem])
			        ),
			        "ID", fVendas[id_cliente_origem]
			    )
			
			VAR Devolucoes =
			    SELECTCOLUMNS(
			        FILTER(
			            fDevolucoes,
			            fDevolucoes[id_cliente] = -1
			                && NOT ISBLANK(fDevolucoes[id_cliente_origem])
			        ),
			        "ID", fDevolucoes[id_cliente_origem]
			    )
			
			RETURN
			    COUNTROWS(
			        DISTINCT(
			            UNION(Vendas, Devolucoes)
			        )
			    )
		formatString: 0
		displayFolder: _Erros\Chaves Orfãs
		lineageTag: 051629a6-0c07-4260-af1b-d8416631d231

