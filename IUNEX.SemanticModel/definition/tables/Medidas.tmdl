table Medidas
	lineageTag: b8902f3e-43be-4373-9da5-1639e04cfe69

	measure 'Receita Bruta' =
			
			SUM(fVendas[receita_bruta])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Receita
		lineageTag: 7278b47c-de30-4ec1-a7e4-77eea950e64d

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Receita Devoluções' =
			
