		formatString: 0
		displayFolder: _Erros
		lineageTag: 7fdd3df5-708a-4b11-8698-79c2a1285a48

	measure 'Registros Rejeitados' =
			
			COUNTROWS(
			    SUMMARIZE(
			        fErros,
			        fErros[Origem],
			        fErros[Linha]
			    )
			)
		formatString: 0
