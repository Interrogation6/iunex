table fMetas
	lineageTag: f3905375-9248-4087-aa2f-f4161f515ffa

	column regiao
		dataType: string
		isHidden
		lineageTag: ce1fa18d-7438-4537-8234-3562d1817be6
		summarizeBy: none
		sourceColumn: regiao

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column segmento
		dataType: string
		isHidden
		lineageTag: 46601e4f-bae9-4743-9f0b-523aafaa2d2c
		summarizeBy: none
		sourceColumn: segmento

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column ano
		dataType: int64
		formatString: 0
		lineageTag: 3c1192be-65b5-4a37-bdce-f94bf5494ba6
		summarizeBy: sum
		sourceColumn: ano

		annotation SummarizationSetBy = Automatic

	column mes
		dataType: string
		lineageTag: 4658bc6d-f4b1-4f61-8587-125186d76dea
		summarizeBy: none
		sourceColumn: mes

		annotation SummarizationSetBy = Automatic

	column valor_meta
		dataType: decimal
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: 55c5a334-6f25-4198-ab1e-aa4d8b1a7bca
		summarizeBy: sum
		sourceColumn: valor_meta

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column data
		dataType: dateTime
		formatString: Long Date
		lineageTag: feeaa31c-52e2-414e-9c2b-eb6aa7f6362a
		summarizeBy: none
		sourceColumn: data

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition fMetas = m
		mode: import
		queryGroup: Modelo
		source =
				let
				    Source = stg_metas,
				
				    RenamedColumns = Table.TransformColumnNames(
				        Source,
				        Text.Lower
				    ),
				    AddedData = Table.AddColumn(
				        RenamedColumns,
				        "data",
				        each
				            let
				                Mes = Text.Upper(Text.Trim([mes])),
				                Meses = {
				                    "JAN", "FEV", "MAR", "ABR",
				                    "MAI", "JUN", "JUL", "AGO",
				                    "SET", "OUT", "NOV", "DEZ"
				                },
				                MesNumero = List.PositionOf(Meses, Mes) + 1
				            in
				                if List.Contains({"META ANO", "TOTAL ANO"}, Mes) then
				                    #date([ano], 12, 31)
				                else if MesNumero > 0 then
				                    #date([ano], MesNumero, 1)
				                else
				                    error [
				                        Reason = "Mês inválido",
				                        Message = "Não foi possível identificar o mês da meta.",
				                        Detail = [mes]
				                    ],
				        type date
				    ),
				
				    RemovedErrors = Table.RemoveRowsWithErrors(
				        AddedData
				    )
				in
				    RemovedErrors

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

