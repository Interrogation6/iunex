	partition dAcessos = m
		mode: import
		queryGroup: Modelo
		source =
				let
				    Source = stg_seguranca_acessos,
				    #"Removed Errors" = Table.RemoveRowsWithErrors(Source),
				    AdjustAtivo = Table.TransformColumns(#"Removed Errors",
				{
				                "ativo",
				                each List.Contains(
				                    {"SIM"},
				                    Text.Upper(Text.Trim(Text.From(_ ?? "")))
				                ),
				                type logical
				            }
				)
				in
				    AdjustAtivo

