	partition fVendas = m
		mode: import
		queryGroup: Modelo
		source =
				let
				    Source = stg_vendas,
				    AddedReceitaBruta = Table.AddColumn(
				    Source,
				    "receita_bruta",
				    each [quantidade] * [valor_unitario_brl],
				    Currency.Type
				),
				    AddedReceitaLiquida = Table.AddColumn(
				    AddedReceitaBruta,
				    "receita_liquida",
				    each [receita_bruta] * (1 - [desconto_pct]),
				    Currency.Type
				),
				    #"Removed Errors" = Table.RemoveRowsWithErrors(AddedReceitaLiquida)
				in
				    #"Removed Errors"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

