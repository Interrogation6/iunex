	column id_cliente =
			
			VAR _Id = fVendas[id_cliente_origem]
			RETURN
			    IF(
			        CONTAINS(
			            dClientes,
			            dClientes[id_cliente], _Id
			        ),
			        _Id,
			        -1
			    )
		isHidden
		formatString: 0
		lineageTag: 6d5a1f93-bcff-45ee-9104-9893c4811f69
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column id_produto =
			
			VAR _Id = fVendas[id_produto_origem]
			RETURN
			    IF(
			        CONTAINS(
			            dProdutos,
			            dProdutos[id_produto], _Id
			        ),
			        _Id,
			        -1
			    )
		isHidden
		lineageTag: 3e9fea56-8642-46d9-8eae-3ab463003e64
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column id_vendedor =
			
			VAR _Id = fVendas[id_vendedor_origem]
			RETURN
			    IF(
			        ISBLANK(_Id),
			        BLANK(),
			        IF(
			            CONTAINS(
			                dVendedores,
			                dVendedores[id_vendedor], _Id
			            ),
			            _Id,
			            -1
			        )
			    )
		isHidden
		formatString: 0
		lineageTag: 6c748b78-4111-446e-8fd9-d6671f3fbcb8
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition fVendas = m
		mode: import
		queryGroup: Modelo
		source =
				let
				    Source = stg_vendas,
				
				    RemoveErrors = Table.RemoveRowsWithErrors(Source),
				
				    AddedReceitaBruta = Table.AddColumn(
				        RemoveErrors,
				        "receita_bruta",
				        each [quantidade] * [valor_unitario_brl],
				        Currency.Type
				    ),
				
				    AddedReceitaLiquida = Table.AddColumn(
				        AddedReceitaBruta,
				        "receita_liquida",
				        each [receita_bruta] * (1 - [desconto_pct]),
				        Currency.Type
				    ),
				
				    FilterFaturado = Table.SelectRows(
				        AddedReceitaLiquida,
				        each [status_pedido] = "Faturado"
				    ),
				    #"Renamed Columns" = Table.RenameColumns(FilterFaturado,{{"id_cliente", "id_cliente_origem"}, {"id_produto", "id_produto_origem"}, {"id_vendedor", "id_vendedor_origem"}})/*,
				
				    IdsClientes = Table.Buffer(
				        Table.Distinct(
				            Table.SelectColumns(
				                dClientes,
				                {"id_cliente"}
				            )
				        )
				    ),
				
				    MergeClientes = Table.NestedJoin(
				        FilterFaturado,
				        {"id_cliente"},
				        IdsClientes,
				        {"id_cliente"},
				        "ClienteEncontrado",
				        JoinKind.LeftOuter
				    ),
				
				    AdjustClientes = Table.AddColumn(
				        MergeClientes,
				        "__id_cliente",
				        each
				            if Table.IsEmpty([ClienteEncontrado]) then
				                -1
				            else
				                [id_cliente],
				        Int64.Type
				    ),
				
				    RemoveClienteAuxiliar = Table.RemoveColumns(
				        AdjustClientes,
				        {"id_cliente", "ClienteEncontrado"}
				    ),
				
				    RenameCliente = Table.RenameColumns(
				        RemoveClienteAuxiliar,
				        {{"__id_cliente", "id_cliente"}}
				    ),
				
				    IdsProdutos = Table.Buffer(
				        Table.Distinct(
				            Table.RenameColumns(
				                Table.SelectColumns(
				                    dProdutos,
				                    {"id_produto"}
				                ),
				                {{"id_produto", "id_produto_encontrado"}}
				            )
				        )
				    ),
				
				    MergeProdutos = Table.Join(
				        RenameCliente,
				        {"id_produto"},
				        IdsProdutos,
				        {"id_produto_encontrado"},
				        JoinKind.LeftOuter
				    ),
				
				    AdjustProdutos = Table.AddColumn(
				        MergeProdutos,
				        "__id_produto",
				        each
				            if [id_produto_encontrado] = null then
				                -1
				            else
				                [id_produto],
				        Int64.Type
				    ),
				
				    RemoveProdutoAuxiliar = Table.RemoveColumns(
				        AdjustProdutos,
				        {"id_produto", "id_produto_encontrado"}
				    ),
				
				    RenameProduto = Table.RenameColumns(
				        RemoveProdutoAuxiliar,
				        {{"__id_produto", "id_produto"}}
				    ),
				
				    IdsVendedores = Table.Distinct(
				        Table.SelectColumns(dVendedores, {"id_vendedor"})
				    ),
				
				    MergeVendedores = Table.NestedJoin(
				        RenameProduto,
				        {"id_vendedor"},
				        IdsVendedores,
				        {"id_vendedor"},
				        "VendedorEncontrado",
				        JoinKind.LeftOuter
				    ),
				
				    AdjustVendedores = Table.AddColumn(
				        MergeVendedores,
				        "__id_vendedor",
				        each
				            if [id_vendedor] = null then
				                null
				            else if Table.IsEmpty([VendedorEncontrado]) then
				                -1
				            else
				                [id_vendedor],
				        Int64.Type
				    ),
				
				    RemoveVendedorAuxiliar = Table.RemoveColumns(
				        AdjustVendedores,
				        {"id_vendedor", "VendedorEncontrado"}
				    ),
				
				    RenameVendedor = Table.RenameColumns(
				        RemoveVendedorAuxiliar,
				        {{"__id_vendedor", "id_vendedor"}}
				    )*/
				in
				    #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

