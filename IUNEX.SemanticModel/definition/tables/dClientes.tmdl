	partition dClientes = m
		mode: import
		queryGroup: Modelo
		source =
				let
				    Source = stg_Clientes,
				
				    RemoveErrors = Table.RemoveRowsWithErrors(Source),
				
				    GetColunas = Table.ColumnNames(RemoveErrors),
				
				    CreateRegistroDesconhecido = Record.FromList(
				        List.Transform(
				            GetColunas,
				            (Coluna) =>
				                if Coluna = "id_cliente" then
				                    -1
				                else if List.Contains(
				                    {"razao_social", "regiao", "segmento"},
				                    Coluna
				                ) then
				                    "Não Identificado"
				                else
				                    null
				        ),
				        GetColunas
				    ),
				
				    CreateClienteDesconhecido = Table.FromRecords(
				        {CreateRegistroDesconhecido},
				        GetColunas
				    ),
				
				    CombineClientes = Table.Combine(
				        {
				            RemoveErrors,
				            CreateClienteDesconhecido
				        },
				        Value.Type(RemoveErrors)
				    )
				in
				    CombineClientes

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

