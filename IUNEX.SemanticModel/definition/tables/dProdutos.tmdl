	partition dProdutos = m
		mode: import
		queryGroup: Modelo
		source =
				let
				    Source = stg_produtos,
				
				    RemoveErrors = Table.RemoveRowsWithErrors(Source),
				
				    GetColunas = Table.ColumnNames(RemoveErrors),
				
				    CreateRegistroDesconhecido = Record.FromList(
				        List.Transform(
				            GetColunas,
				            (Coluna) =>
				                if Coluna = "id_produto" then
				                    -1
				                else if List.Contains(
				                    {
				                        "descricao",
				                        "categoria",
				                        "subcategoria",
				                        "linha"
				                    },
				                    Coluna
				                ) then
				                    "Não Identificado"
				                else
				                    null
				        ),
				        GetColunas
				    ),
				
				    CreateProdutoDesconhecido = Table.FromRecords(
				        {CreateRegistroDesconhecido},
				        GetColunas
				    ),
				
				    CombineProdutos = Table.Combine(
				        {
				            RemoveErrors,
				            CreateProdutoDesconhecido
				        },
				        Value.Type(RemoveErrors)
				    )
				in
				    CombineProdutos

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

