	partition dVendedores = m
		mode: import
		queryGroup: Modelo
		source =
				let
				    Source = stg_vendedores,
				
				    RemoveErrors = Table.RemoveRowsWithErrors(Source),
				
				    GetColunas = Table.ColumnNames(RemoveErrors),
				
				    CreateRegistroDesconhecido = Record.FromList(
				        List.Transform(
				            GetColunas,
				            (Coluna) =>
				                if Coluna = "id_vendedor" then
				                    -1
				                else if List.Contains(
				                    {
				                        "nome",
				                        "cargo",
				                        "regiao"
				                    },
				                    Coluna
				                ) then
				                    "Não Identificado"
				                else
				                    null
				        ),
				        GetColunas
				    ),
				
				    CreateVendedorDesconhecido = Table.FromRecords(
				        {CreateRegistroDesconhecido},
				        GetColunas
				    ),
				
				    CombineVendedores = Table.Combine(
				        {
				            RemoveErrors,
				            CreateVendedorDesconhecido
				        },
				        Value.Type(RemoveErrors)
				    )
				in
				    CombineVendedores

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

