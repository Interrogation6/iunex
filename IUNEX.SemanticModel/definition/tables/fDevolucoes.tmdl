	column id_cliente =
			
			VAR _Id = fDevolucoes[id_cliente_origem]
			RETURN
			    IF(
			        CONTAINS(
			            dClientes,
			            dClientes[id_cliente], _Id
			        ),
			        _Id,
			        -1
			    )
		isHidden
		formatString: 0
		lineageTag: 88f0e7aa-3245-46d1-820f-c4a53cc9dfb3
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column id_produto =
			
			VAR _Id = fDevolucoes[id_produto_origem]
			RETURN
			    IF(
			        CONTAINS(
			            dProdutos,
			            dProdutos[id_produto], _Id
			        ),
			        _Id,
			        -1
			    )
		isHidden
		formatString: 0
		lineageTag: 3450f989-f3f1-47e7-85f8-01023c6da419
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column id_vendedor =
			
			VAR _Id = fDevolucoes[id_vendedor_origem]
			RETURN
			    IF(
			        ISBLANK(_Id),
			        BLANK(),
			        IF(
			            CONTAINS(
			                dVendedores,
			                dVendedores[id_vendedor], _Id
			            ),
			            _Id,
			            -1
			        )
			    )
		isHidden
		formatString: 0
		lineageTag: 2f1f9143-3b63-4b2e-aa90-8ffe982bc795
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

