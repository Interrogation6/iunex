table dCalendario
	lineageTag: 534d6fd8-dc85-43ab-be73-1f768d953064
	dataCategory: Time

	measure 'Exibir FY Atual' =
			
			VAR FYMaxSelecionado =
			    MAXX(
			        ALLSELECTED(dCalendario),
			        dCalendario[anofiscal]
			    )
			
			VAR FYDoPonto =
			    SELECTEDVALUE(dCalendario[anofiscal])
			
			RETURN
			    IF(
			        FYDoPonto = FYMaxSelecionado,
			        1,
			        0
			    )
		formatString: 0
		displayFolder: Ano Fiscal
		lineageTag: b7c3181a-3bea-4afd-9891-60cd5a0cdb8f

