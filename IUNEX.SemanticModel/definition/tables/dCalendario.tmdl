	partition dCalendario = m
		mode: import
		queryGroup: Modelo
		source =
				let
				    AnoInicial = 2024,
				
				    AnoFinal = List.Max({
				        2026,
				        Date.Year(Date.From(DateTime.FixedLocalNow()))
				    }),
				
				    DataInicial = #date(AnoInicial, 1, 1),
				    DataFinal = #date(AnoFinal + 1, 3, 31),
				
				    Datas = List.Dates(
				        DataInicial,
				        Duration.Days(DataFinal - DataInicial) + 1,
				        #duration(1, 0, 0, 0)
				    ),
				
				    Calendario = Table.FromList(
				        Datas,
				        Splitter.SplitByNothing(),
				        {"Data"}
				    ),
				
				    TiparData = Table.TransformColumnTypes(
				        Calendario,
				        {{"Data", type date}}
				    ),
				
				    AddAno = Table.AddColumn(
				        TiparData, "Ano",
				        each Date.Year([Data]),
				        Int64.Type
				    ),
				
				    AddMesNumero = Table.AddColumn(
				        AddAno, "MesNumero",
				        each Date.Month([Data]),
				        Int64.Type
				    ),
				
				    AddMesNome = Table.AddColumn(
				        AddMesNumero, "MesNome",
				        each Date.MonthName([Data], "pt-BR"),
				        type text
				    ),
				
				    AddMesAno = Table.AddColumn(
				        AddMesNome, "MesAno",
				        each Date.ToText([Data], "MMM/yyyy", "pt-BR"),
				        type text
				    ),
				
				    AddMesAnoOrdem = Table.AddColumn(
				        AddMesAno, "MesAnoOrdem",
				        each [Ano] * 100 + [MesNumero],
				        Int64.Type
				    ),
				
				    AddInicioMes = Table.AddColumn(
				        AddMesAnoOrdem, "InicioMes",
				        each Date.StartOfMonth([Data]),
				        type date
				    ),
				
				    AddTrimestre = Table.AddColumn(
				        AddInicioMes, "Trimestre",
				        each "T" & Text.From(Date.QuarterOfYear([Data])),
				        type text
				    ),
				
				    AddAnoFiscal = Table.AddColumn(
				        AddTrimestre, "AnoFiscal",
				        each if [MesNumero] >= 4
				             then [Ano] + 1
				             else [Ano],
				        Int64.Type
				    ),
				
				    AddAnoFiscalNome = Table.AddColumn(
				        AddAnoFiscal, "AnoFiscalNome",
				        each "FY" & Text.From([AnoFiscal]),
				        type text
				    ),
				
				    AddMesFiscal = Table.AddColumn(
				        AddAnoFiscalNome, "MesFiscal",
				        each Number.Mod([MesNumero] + 8, 12) + 1,
				        Int64.Type
				    ),
				
				    AddTrimestreFiscal = Table.AddColumn(
				        AddMesFiscal, "TrimestreFiscal",
				        each "T" & Text.From(
				            Number.RoundUp([MesFiscal] / 3)
				        ),
				        type text
				    ),
				
				    AddDiaSemanaNumero = Table.AddColumn(
				        AddTrimestreFiscal, "DiaSemanaNumero",
				        each Date.DayOfWeek([Data], Day.Monday) + 1,
				        Int64.Type
				    ),
				
				    AddDiaSemanaNome = Table.AddColumn(
				        AddDiaSemanaNumero, "DiaSemanaNome",
				        each Date.DayOfWeekName([Data], "pt-BR"),
				        type text
				    ),
				
				    AddFimSemana = Table.AddColumn(
				        AddDiaSemanaNome, "IsFimSemana",
				        each [DiaSemanaNumero] >= 6,
				        type logical
				    ),
				
				    FeriadosValidos = Table.SelectRows(
				        feriados,
				        each [data] <> null
				    ),
				
				    AgruparFeriados = Table.Group(
				        FeriadosValidos,
				        {"data"},
				        {
				            {
				                "DescricaoFeriado",
				                each Text.Combine(
				                    List.Distinct(
				                        List.RemoveNulls([descricao])
				                    ),
				                    " | "
				                ),
				                type text
				            },
				            {
				                "AbrangenciaFeriado",
				                each Text.Combine(
				                    List.Distinct(
				                        List.RemoveNulls([abrangencia])
				                    ),
				                    " | "
				                ),
				                type text
				            },
				            {
				                "IsFeriadoNacional",
				                each List.AnyTrue(
				                    List.Transform(
				                        [abrangencia],
				                        (Valor) =>
				                            if Valor = null then false
				                            else Text.Contains(
				                                Text.Upper(Text.From(Valor)),
				                                "NACIONAL"
				                            )
				                    )
				                ),
				                type logical
				            }
				        }
				    ),
				
				    MergeFeriados = Table.NestedJoin(
				        AddFimSemana,
				        {"Data"},
				        AgruparFeriados,
				        {"data"},
				        "Feriado",
				        JoinKind.LeftOuter
				    ),
				
				    ExpandFeriados = Table.ExpandTableColumn(
				        MergeFeriados,
				        "Feriado",
				        {
				            "DescricaoFeriado",
				            "AbrangenciaFeriado",
				            "IsFeriadoNacional"
				        }
				    ),
				
				    AddIsFeriado = Table.AddColumn(
				        ExpandFeriados, "IsFeriado",
				        each [DescricaoFeriado] <> null,
				        type logical
				    ),
				
				    CorrigirFlagNacional = Table.TransformColumns(
				        AddIsFeriado,
				        {
				            {
				                "IsFeriadoNacional",
				                each if _ = null then false else _,
				                type logical
				            }
				        }
				    ),
				
				    AddIsDiaUtil = Table.AddColumn(
				        CorrigirFlagNacional, "IsDiaUtil",
				        each not [IsFimSemana]
				             and not [IsFeriadoNacional],
				        type logical
				    )
				in
				    AddIsDiaUtil

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

