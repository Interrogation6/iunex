		sourceColumn: Motivo

		annotation SummarizationSetBy = Automatic

	partition fErros = m
		mode: import
		queryGroup: Modelo
		source =
				let
				    Fontes =
				        // Reúne quarentenas de vendas, dimensões, devoluções e metas.
				        {
				        fxQuarentena(
				            stg_vendas,
				            "Vendas",
				            {"id_pedido", "item"}
				        ),
				
				        fxQuarentena(
				            stg_Clientes,
				            "Clientes",
				            {"id_cliente"}
				        ),
				
				        fxQuarentena(
				            stg_produtos,
				            "Produtos",
				            {"id_produto"}
				        ),
				
				        fxQuarentena(
				            stg_vendedores,
				            "Vendedores",
				            {"id_vendedor"}
				        ),
				
				        fxQuarentena(
				            stg_devolucoes,
				            "Devoluções",
				            {"id_devolucao", "item"}
				        ),
				
				        fxQuarentena(
				            stg_Carteira_Historica,
				            "Carteira Histórica",
				            {"id_cliente", "id_vendedor"}
				        ),
				
				        fxQuarentena(
				            stg_metas,
				            "Metas",
				            {"Regiao", "Segmento", "Ano", "Mes"}
				        )
				    },
				
				    Resultado = Table.Combine(Fontes)
				in
				    Resultado

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

