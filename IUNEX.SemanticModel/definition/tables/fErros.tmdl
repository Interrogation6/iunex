				            "Carteira Histórica",
				            {"id_cliente", "id_vendedor"}
				        ),
				
				        fxQuarentena(
				            stg_metas,
				            "Metas",
				            {"Regiao", "Segmento", "Ano", "Mes"}
				        )
				    },
				
				    Resultado = Table.Combine(Fontes)
				in
				    Resultado

