role RLS_Dinamico
	modelPermission: read

	tablePermission dRegiao =
			VAR RegiaoPermitida =
			    CALCULATE(
			        SELECTEDVALUE(dAcessos[regiao_permitida]),
			        dAcessos[ativo] = TRUE(),
			        dAcessos[email] = USERPRINCIPALNAME()
			    )
			
			RETURN
			    RegiaoPermitida = "TODAS"
			        || [regiao] = RegiaoPermitida

	tablePermission dAcessos =
			([ativo] == true())
			&& ([email] == USERPRINCIPALNAME())

	tablePermission dSegmento =
			VAR SegmentoPermitido =
			    CALCULATE(
			        SELECTEDVALUE(dAcessos[segmento_permitido]),
			        dAcessos[ativo] = TRUE(),
			        dAcessos[email] = USERPRINCIPALNAME()
			    )
			
			RETURN
			    SegmentoPermitido = "TODOS"
			        || [segmento] = SegmentoPermitido

	tablePermission fErros =
			VAR Ativo =
			    CALCULATE(
			        SELECTEDVALUE(dAcessos[ativo]),
			        dAcessos[nome] = USERPRINCIPALNAME()
			    )
			
			RETURN
			    Ativo == TRUE()

	annotation PBI_Id = 7d1ce7be14674e0d964a4e8e48230bfd

